#!/usr/bin/env python3
"""
vidscope — see inside any video without watching it.

  vidscope probe  VIDEO [--json]                technical forensics
  vidscope sheet  VIDEO --rung {1,2,3} [...]    contact sheets for vision
  vidscope brief  VIDEO [--target 21 34]        readable report + segment plan

Thin dispatcher: the real work lives in vd_probe.py / vd_sheet.py / vd_brief.py
next to this file, so each can also be used standalone or imported.
"""
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent

COMMANDS = {
    "probe": ("vd_probe.py", "technical forensics: duration, cuts, black/freeze, luma, flags"),
    "sheet": ("vd_sheet.py", "contact sheets at rung 1 (330px) / 2 (760px) / 3 (1080px)"),
    "brief": ("vd_brief.py", "markdown brief + beat table + pre-filled vision prompt"),
}

VERSION = "1.0.4"


def usage():
    print("vidscope — see inside any video without watching it\n")
    print("usage: vidscope COMMAND [args...]\n")
    print("commands:")
    for name, (_, desc) in COMMANDS.items():
        print(f"  {name:<8} {desc}")
    print("\nexamples:")
    print("  vidscope probe clip.mp4")
    print("  vidscope probe clip.mp4 --json")
    print("  vidscope sheet clip.mp4 --rung 1")
    print("  vidscope sheet clip.mp4 --rung 3 --times 5.0 5.5 6.0")
    print("  vidscope brief clip.mp4 --target 21 34")
    print("\nnote: brief accepts a VIDEO and probes it for you;")
    print("      vd_brief.py itself consumes a JSON file when called directly.")
    print(f"\nvidscope {VERSION} · MIT · requires ffmpeg on PATH")


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        sys.exit(0)
    if argv[0] in ("-v", "--version", "version"):
        print(VERSION)
        sys.exit(0)

    cmd = argv[0]
    if cmd not in COMMANDS:
        print(f"vidscope: unknown command '{cmd}'\n", file=sys.stderr)
        usage()
        sys.exit(2)

    script = HERE / COMMANDS[cmd][0]
    if not script.exists():
        print(f"vidscope: missing implementation {script}", file=sys.stderr)
        sys.exit(2)

    # `brief` is advertised as taking a video; vd_brief.py wants probe JSON.
    # Keep the public CLI honest by probing first when given a video file.
    args = argv[1:]
    if cmd == "brief" and args and not args[0].endswith(".json"):
        video = args[0]
        rest = args[1:]
        probe_script = HERE / "vd_probe.py"
        p = subprocess.run([sys.executable, str(probe_script), video, "--json"],
                           capture_output=True, text=True)
        if p.returncode != 0:
            sys.stderr.write(p.stdout + p.stderr)
            sys.exit(p.returncode)
        # feed the JSON in via stdin so no temp file is created
        q = subprocess.run([sys.executable, str(script), "-", *rest],
                           input=p.stdout, text=True)
        sys.exit(q.returncode)

    sys.exit(subprocess.run([sys.executable, str(script), *args]).returncode)


if __name__ == "__main__":
    main()
